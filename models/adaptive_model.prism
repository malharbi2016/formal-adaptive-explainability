smg

const double w_info;
const double p_sat_comp;
const double p_sat_min;
const double p_help;
const double c_exp;

global turn   : [0..2] init 0;
global hstage : [0..2] init 0;
global done   : bool init false;

label "done" = done;

module RVC
  exp : [0..1] init 0;

  [Explain] (turn=0) & (!done) ->
      w_info:(exp'=1) & (turn'=1) & (hstage'=0)
    + (1-w_info):(exp'=0) & (turn'=1) & (hstage'=0);
endmodule

module HUMAN
  Satisfy : bool init false;
  Resp    : [0..1] init 0;

  [Assess] (turn=1) & (hstage=0) & (exp=1) & (!done) ->
      p_sat_comp:(Satisfy'=true) & (hstage'=1)
    + (1-p_sat_comp):(Satisfy'=false) & (hstage'=1);

  [Assess] (turn=1) & (hstage=0) & (exp=0) & (!done) ->
      p_sat_min:(Satisfy'=true) & (hstage'=1)
    + (1-p_sat_min):(Satisfy'=false) & (hstage'=1);

  [Respond] (turn=1) & (hstage=1) & (Satisfy=true) & (!done) ->
      p_help:(Resp'=1) & (hstage'=2)
    + (1-p_help):(Resp'=0) & (hstage'=2);

  [Respond] (turn=1) & (hstage=1) & (Satisfy=false) & (!done) ->
      0.3:(Resp'=1) & (hstage'=2)
    + 0.7:(Resp'=0) & (hstage'=2);

  [Record] (turn=1) & (hstage=2) & (!done) ->
      (turn'=2) & (hstage'=0);
endmodule

module ENV
  step : [0..9] init 0;

  [Step] (turn=2) & (step<9) & (!done) ->
      (step'=step+1) & (turn'=0);

  [Finish] (turn=2) & (step=9) & (!done) ->
      (done'=true);

  [End] done ->
      (done'=true);
endmodule

player RVC
  [Explain]
endplayer

player HUMAN
  [Assess], [Respond], [Record]
endplayer

player ENVIRONMENT
  [Step], [Finish], [End]
endplayer

rewards "utility"
  [Record] Satisfy=true : 1;
endrewards

rewards "cost"
  [Record] exp=1 : c_exp;
endrewards

rewards "helpful_count"
  [Record] Resp=1 : 1;
endrewards

rewards "satisfaction_count"
  [Record] Satisfy=true : 1;
endrewards

rewards "comprehensive_count"
  [Record] exp=1 : 1;
endrewards

rewards "minimal_count"
  [Record] exp=0 : 1;
endrewards
